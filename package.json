{
  "name": "economic-intelligence-cloudflare",
  "private": true,
  "type": "module",
  "version": "1.1.0",
  "description": "Cloudflare Workers + D1 + Telegram: economic intelligence dashboard and personal skill development system",
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "db:create": "wrangler d1 create economic-intelligence-db",
    "db:migrate:local": "wrangler d1 migrations apply economic-intelligence-db --local",
    "db:migrate:remote": "wrangler d1 migrations apply economic-intelligence-db --remote",
    "tail": "wrangler tail",
    "test": "node tests/api.test.mjs",
    "check:curriculum": "node tests/curriculum.test.mjs"
  },
  "devDependencies": {
    "wrangler": "^4.151.0"
  }
}
